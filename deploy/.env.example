# S3-compatible storage for show images (your provider's endpoint, bucket and keys)
S3_ENDPOINT=https://s3.example-provider.com
S3_REGION=us-east-1
S3_BUCKET=london-theatre-planner
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Secret typed on the Scrapes page to start a scrape (generate with: openssl rand -hex 16)
SCRAPE_TOKEN=

# Weekly scrape, cron syntax in Europe/London time. Default: Mondays 05:00. Empty disables it.
# SCRAPE_CRON=0 5 * * 1
